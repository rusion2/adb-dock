<Window x:Class="AdbDock.App.DevicePreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备预览" Width="280" Height="198" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True" WindowStartupLocation="Manual" AutomationProperties.AutomationId="PreviewWindow">
  <Border x:Name="Card" Padding="14,10" CornerRadius="12" Background="#FEFDFF" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform>
    <StackPanel xmlns:local="clr-namespace:AdbDock.App">
      <DockPanel><TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding Status}" ToolTip="{Binding Status}" MaxWidth="70"
                            TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{Binding Tone}" FontSize="11" VerticalAlignment="Center"/>
        <local:DevicePicker x:Name="PreviewDeviceSwitcher" AutomationProperties.AutomationId="PreviewDeviceSwitcher" AutomationProperties.Name="切换预览设备"/></DockPanel>
      <TextBlock x:Name="SerialText" Text="{Binding Serial}" ToolTip="{Binding Serial}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"
                 Margin="0,3,0,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PreviewSerial"/>
      <UniformGrid x:Name="ActionGrid" Rows="2" Columns="3" Button.Click="ActionClick">
        <UniformGrid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="2,4"/><Setter Property="FontSize" Value="12"/></Style></UniformGrid.Resources>
        <Button Content="设备投屏" Tag="mirror" AutomationProperties.AutomationId="PreviewAction:mirror"/>
        <Button Content="截图" Tag="screenshot" AutomationProperties.AutomationId="PreviewAction:screenshot"/>
        <Button Content="安装 APK" Tag="install" AutomationProperties.AutomationId="PreviewAction:install"/>
        <Button Content="按键控制" Tag="keys" AutomationProperties.AutomationId="PreviewAction:keys"/>
        <Button Content="设备信息" Tag="info" AutomationProperties.AutomationId="PreviewAction:info"/>
        <Button Content="查看日志" Tag="logcat" AutomationProperties.AutomationId="PreviewAction:logcat"/>
      </UniformGrid>
      <TextBlock x:Name="Feedback" Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
    </StackPanel>
  </Border>
</Window>
